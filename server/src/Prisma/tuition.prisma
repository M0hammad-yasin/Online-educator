generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb" // or "postgresql" if using PostgreSQL
  url      = env("MONGO_URI")
}

model Admin {
   id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String        @unique
  passwordHash    String
  role            Role          @default(ADMIN)
  profilePicture  String?       // Cloudinary URL
  isEmailVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Moderator{
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String        @unique
  passwordHash    String
  address         String?
  moderatorAccessControl   ModeratorAccessControl?
  role            Role          @default(MODERATOR)
  profilePicture  String?       // Cloudinary URL
  isEmailVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Teacher {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  profilePicture  String?       // Cloudinary URL
  name            String
  email           String        @unique
  qualification   String?
  classRate       Int?
  classes         Class[]
  role            Role        @default(TEACHER)  // ADMIN, TEACHER, or STUDENT
  passwordHash    String
  address         String?
  teacherAccessControl   TeacherAccessControl?
  isEmailVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isDeleted Boolean @default(false)
}

model Student {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String        @unique
  profilePicture  String?       // Cloudinary URL
  parentEmail     String?
  grade           Int
  passwordHash    String
  address         String?
  role            Role          @default(STUDENT)// ADMIN, TEACHER, or STUDENT
  isEmailVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  classes         Class[]
  region          String?
  isDeleted Boolean @default(false)
}

model Class {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  subject         String
  scheduledAt     DateTime
  startTime       DateTime 
  title           String?    
  endTime         DateTime
  teacher         Teacher       @relation(fields: [teacherId], references: [id])
  teacherId       String        @db.ObjectId
  student         Student       @relation(fields: [studentId], references: [id])
  studentId       String        @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  classLink       String?
  duration        Int 
  status          ClassStatus   @default(SCHEDULED)
}
model TeacherAccessControl {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  teacher        Teacher?  @relation(fields: [teacherId], references: [id])
  teacherId      String   @unique @db.ObjectId

  // Permissions for class and student management
  canSeeClass     Boolean  @default(true)
  canAddClass     Boolean  @default(true)
  canUpdateClass  Boolean  @default(true)
  canDeleteClass  Boolean  @default(false)

  canSeeStudent   Boolean  @default(true)
  canAddStudent   Boolean  @default(false)
  canUpdateStudent Boolean @default(false)
  canDeleteStudent Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ModeratorAccessControl {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  moderator    Moderator?  @relation(fields: [moderatorId], references: [id])
  moderatorId     String     @unique @db.ObjectId

  // Permissions for teachers, students, and classes

  canSeeTeacher   Boolean    @default(true)
  canAddTeacher   Boolean    @default(false)
  canUpdateTeacher Boolean   @default(true)
  canDeleteTeacher Boolean   @default(false)

  canSeeStudent   Boolean    @default(true)
  canAddStudent   Boolean    @default(false)
  canUpdateStudent Boolean   @default(true)
  canDeleteStudent Boolean   @default(false)

  canSeeClass     Boolean    @default(true)
  canAddClass     Boolean    @default(true)
  canUpdateClass  Boolean    @default(true)
  canDeleteClass  Boolean    @default(false)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  MODERATOR
  }
  
enum ClassStatus { 
  SCHEDULED
  COMPLETED
  IN_PROGRESS
  CANCELLED
  }
