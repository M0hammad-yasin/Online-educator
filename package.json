{
  "name": "online-educator",
  "version": "1.0.0",
  "description": "Online Educator Platform with Client and Server",
  "scripts": {
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" --prefix \"[{name}]\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
